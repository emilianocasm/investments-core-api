      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const EPOCH = 1400000000;\nconst ALPHABET = '0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz';\n\nfunction generarKsuid() {\n  const bytes = new Array(20).fill(0);\n\n  // 4 bytes de timestamp (big endian)\n  const ts = Math.floor(Date.now() / 1000) - EPOCH;\n  bytes[0] = (ts >>> 24) & 0xff;\n  bytes[1] = (ts >>> 16) & 0xff;\n  bytes[2] = (ts >>> 8) & 0xff;\n  bytes[3] = ts & 0xff;\n\n  // 16 bytes aleatorios (CryptoJS viene incluido en el sandbox de Postman)\n  const words = CryptoJS.lib.WordArray.random(16).words;\n  for (let i = 0; i < 4; i++) {\n    const w = words[i];\n    bytes[4 + i * 4]     = (w >>> 24) & 0xff;\n    bytes[4 + i * 4 + 1] = (w >>> 16) & 0xff;\n    bytes[4 + i * 4 + 2] = (w >>> 8) & 0xff;\n    bytes[4 + i * 4 + 3] = w & 0xff;\n  }\n\n  // Codificación base62 (división sucesiva de los 20 bytes)\n  const digits = [];\n  let num = bytes.slice();\n  while (num.some(b => b !== 0)) {\n    let rem = 0;\n    const q = [];\n    for (const b of num) {\n      const acc = rem * 256 + b;\n      const d = Math.floor(acc / 62);\n      rem = acc % 62;\n      if (q.length || d) q.push(d);\n    }\n    digits.push(rem);\n    num = q;\n  }\n  while (digits.length < 27) digits.push(0);\n\n  return digits.reverse().map(d => ALPHABET[d]).join('');\n}\n\npm.environment.set('ksuid', generarKsuid());"
            ]
          }
        }
